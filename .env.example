# --- Base de données / Redis (en local, hors Docker) ---
# PostgreSQL avec pgvector : celui de `docker compose up -d db` (port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/meetingai
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-at-least-32-random-characters-long

# Docker Compose uniquement : mot de passe PostgreSQL (évite les caractères spéciaux @ : / ?)
POSTGRES_PASSWORD=postgres

# --- LLM : "groq" (cloud) ou "ollama" (local, on-premise) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Whisper (pour l'arabe, prends au moins "small") ---
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- RAG (recherche dans les réunions, avec citations) ---
RAG_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Sous Windows, fixe un dossier stable (le dossier temporaire peut être vidé), ex. :
# EMBEDDING_CACHE_DIR=C:\Users\omran\.cache\fastembed
RAG_CHUNK_CHARS=700
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.25

# --- Divers ---
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=200
# Dev uniquement (sans Alembic). En production laisse false et lance : alembic upgrade head
AUTO_CREATE_TABLES=false
